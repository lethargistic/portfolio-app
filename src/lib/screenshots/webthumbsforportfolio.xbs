<?xml version="1.0" encoding="UTF-8"?><XnView_script version="1.0" name="webthumbsforportfolio">
    <Resize mode="5" width="600" height="600" unit="0" ratio="true" orientation="false" enlarge="0" resample="7" gamma_correct="false"/>
